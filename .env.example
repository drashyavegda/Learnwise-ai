# ---------------------------------------------------------------------------
# LearnWise AI — environment example. Copy to .env and fill in what you need.
# Nothing here is required: the app runs fully in demo mode with no key.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# Client flag. Leave unset (or false) for demo mode: the tutor uses the
# predefined content pack and the UI says so. Set to true only when the
# server below is running and configured with a key.
VITE_ENABLE_AI=false

# Server-only key. Read by `npm run server`, never bundled into the browser.
LEARNWISE_AI_KEY=

# Optional: any OpenAI-compatible chat-completions endpoint and model.
LEARNWISE_AI_URL=https://api.openai.com/v1/chat/completions
LEARNWISE_AI_MODEL=gpt-4o-mini

# Port for the optional API server (Vite proxies /api here).
PORT=8787

# Optional: point the dev proxy somewhere else.
# LEARNWISE_API=http://127.0.0.1:8787
